<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>نسيت كلمة المرور | SENTINEL-AI</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'IBM Plex Sans Arabic', sans-serif; }
  </style>
</head>
<body class="bg-[#0B1426] text-white min-h-screen flex items-center justify-center p-4">

  <div class="w-full max-w-md">
    <!-- Logo -->
    <div class="flex items-center justify-center gap-2.5 mb-8">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-blue-600 flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
      </div>
      <div>
        <div class="font-bold text-sm">SENTINEL-AI</div>
        <div class="text-[10px] text-slate-400">منصة ذكاء أمني</div>
      </div>
    </div>

    <!-- Card -->
    <div class="bg-[#111C33] border border-white/10 rounded-2xl p-7 shadow-2xl">
      <h1 class="text-xl font-bold mb-2">نسيت كلمة المرور؟</h1>
      <p class="text-sm text-slate-400 mb-6 leading-relaxed">
        أدخل بريدك الإلكتروني وسنرسل لك رابط إعادة تعيين كلمة المرور.
      </p>

      <form id="forgotForm" onsubmit="handleSubmit(event)">
        <label class="block text-sm text-slate-300 mb-1.5">البريد الإلكتروني</label>
        <input 
          type="email" 
          id="email"
          required
          placeholder="you@example.com"
          class="w-full px-4 py-3 rounded-xl bg-[#1A2744] border border-white/10 text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition mb-5"
        />

        <button 
          type="submit"
          class="w-full py-3 rounded-xl bg-indigo-500 hover:bg-indigo-400 font-semibold transition shadow-lg shadow-indigo-500/20"
        >
          إرسال رابط الاستعادة
        </button>
      </form>

      <!-- Success message (hidden by default) -->
      <div id="successMsg" class="hidden mt-5 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-sm text-center">
        تم إرسال الرابط إلى بريدك الإلكتروني (إن وُجد الحساب).
      </div>

      <div class="mt-6 text-center">
        <a href="/dashboard" class="text-sm text-indigo-400 hover:text-indigo-300 transition">
          ← العودة لتسجيل الدخول
        </a>
      </div>
    </div>
  </div>

  <script>
    function handleSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('email').value;
      
      // هنا تحط طلب API الخاص فيك لاحقاً
      // حالياً بس نعرض رسالة نجاح
      document.getElementById('forgotForm').classList.add('hidden');
      document.getElementById('successMsg').classList.remove('hidden');
      
      console.log('Reset requested for:', email);
    }
  </script>
</body>
</html>